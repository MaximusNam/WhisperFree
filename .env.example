# Ключ провайдера. Скопируйте этот файл в .env и подставьте свой.
# Groq: https://console.groq.com/keys  (бесплатный тариф без карты)
GROQ_API_KEY=

# Если провайдер другой, поменяйте имя переменной в config.toml -> [provider].api_key_env
# OPENAI_API_KEY=

# Сам .env в репозиторий не попадает: он перечислен в .gitignore.
# Ключ не пишется и в config.toml — это проверяется тестом.
# Если ключ всё же куда-то утёк, отзовите его в консоли провайдера:
# смены пароля мало, нужен именно отзыв ключа.
