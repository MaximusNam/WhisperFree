{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "4.0.0",
  "default_theme": "graphite_slate",
  "geometry": {
    "width": 185,
    "height": 36,
    "corner_radius": 18,
    "shape": "pill",
    "padding_x": 14,
    "padding_y": 6,
    "border_width": 1.5,
    "indicator_dot_size": 8,
    "level_bar_height": 2.5
  },
  "themes": {
    "graphite_slate": {
      "id": "graphite_slate",
      "name_ru": "Холодный Сланец (как на вашем скриншоте)",
      "description": "Строгий холодный серый кант, нейтральная графитовая точка, идеальная гармония с черным шрифтом документов.",
      "surface": {
        "background_rgba": "rgba(30, 41, 59, 0.13)",
        "alpha": 0.13,
        "backdrop_blur_px": 0,
        "border_rgba": "rgba(71, 85, 105, 0.75)",
        "shadow_rgba": "rgba(15, 23, 42, 0.12)"
      },
      "typography": {
        "font_family": "Segoe UI Variable Text, Inter, sans-serif",
        "font_size": 13,
        "font_weight": "SemiBold",
        "text_primary": "#0F172A"
      },
      "states": {
        "recording": { "label": "Запись…", "color": "#64748B", "glow_rgba": "rgba(100, 116, 139, 0.35)" },
        "silent":    { "label": "Микрофон молчит", "color": "#94A3B8", "glow_rgba": "rgba(148, 163, 184, 0.30)" },
        "sending":   { "label": "Распознаю…", "color": "#D97706", "glow_rgba": "rgba(217, 119, 6, 0.40)" },
        "refining":  { "label": "Правлю текст…", "color": "#475569", "glow_rgba": "rgba(71, 85, 105, 0.40)" },
        "ok":        { "label": "Готово", "color": "#16A34A", "glow_rgba": "rgba(22, 163, 74, 0.45)" },
        "error":     { "label": "Ошибка", "color": "#DC2626", "glow_rgba": "rgba(220, 38, 38, 0.50)" }
      }
    },
    "graphite_warm_taupe": {
      "id": "graphite_warm_taupe",
      "name_ru": "Тёплый Дымчатый Мокко (Уютный графит)",
